# ---------------------------------------------------------------------------
# server/.env  —  copy to server/.env and fill in.
# Every value here is server-side only and must never be exposed to the client.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins.
# In production set this to your Vercel URL, e.g. https://text-to-learn.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas ---------------------------------------------------------
# Atlas > Cluster > Connect > Drivers. Remember to URL-encode the password.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/text-to-learn?retryWrites=true&w=majority

# --- Auth0 -----------------------------------------------------------------
# Auth0 Dashboard > Applications > APIs > your API.
# The trailing slash on the issuer URL is required.
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://text-to-learn/api

# --- Google Gemini ---------------------------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs are env-driven because Gemini identifiers change often. Confirm the
# current values at https://ai.google.dev/gemini-api/docs/models before deploying.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# --- YouTube Data API v3 ---------------------------------------------------
# Google Cloud Console > enable "YouTube Data API v3" > create an API key.
# NOTE: this stays server-side. Do NOT copy it into client/.env — anything
# prefixed VITE_ is inlined into the public JS bundle.
YOUTUBE_API_KEY=

# --- Abuse / cost controls -------------------------------------------------
RATE_LIMIT_GENERATIONS=10
RATE_LIMIT_WINDOW_MINUTES=60
