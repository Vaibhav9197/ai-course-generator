# ---------------------------------------------------------------------------
# client/.env  —  copy to client/.env and fill in.
#
# WARNING: every VITE_* value is inlined into the public JavaScript bundle and is
# readable by anyone who loads the site. Only put non-secret values here.
# API keys (Gemini, YouTube) belong in server/.env and nowhere else.
# ---------------------------------------------------------------------------

# Leave EMPTY in development so requests go through Vite's /api dev proxy.
# In production (Vercel) set this to your Render URL, e.g.
#   https://text-to-learn-backend.onrender.com
VITE_API_URL=

# --- Auth0 (public SPA values — safe to expose) ----------------------------
# Auth0 Dashboard > Applications > your SPA application.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=

# Must match AUTH0_AUDIENCE in server/.env exactly. Without it Auth0 issues an
# opaque token instead of a JWT and every API call will 401.
VITE_AUTH0_AUDIENCE=https://text-to-learn/api
